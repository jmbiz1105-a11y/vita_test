rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: consultations
    // Document ID: auto-generated
    // Fields:
    //   - carrier: string (required, enum: ['KT', 'SK', 'LG', 'None'])
    //   - name: string (required, 1-100 chars)
    //   - phone: string (required, format: phone)
    //   - createdAt: timestamp (required)
    //   - status: string (required, enum: ['pending', 'contacted', 'completed'])
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "jmbiz1105@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidConsultation(data) {
      return data.keys().hasAll(['carrier', 'name', 'phone', 'createdAt', 'status']) &&
             data.carrier in ['KT', 'SK', 'LG', 'None'] &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.matches('^[0-9\\-\\+ ]{7,20}$') &&
             data.createdAt is timestamp &&
             data.status == 'pending';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /consultations/{consultationId} {
      // Anyone can submit a consultation request
      allow create: if isValidConsultation(request.resource.data);
      
      // Only admins can read or update consultation requests
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if isAdmin();
    }
  }
}
